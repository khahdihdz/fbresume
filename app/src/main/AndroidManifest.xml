<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_fbresume"
        android:roundIcon="@drawable/ic_fbresume"
        android:label="FBResume"
        android:theme="@style/AppTheme">
        <meta-data android:name="com.khahdihdz.fbresume.UPDATE_URL" android:value="https://github.com/khahdihdz/fbresume/releases/latest" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Nhận video được chia sẻ từ ứng dụng Facebook (Chia sẻ → FBResume) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- Nhận liên kết video Facebook mở trực tiếp (pathPrefix giới hạn cho video/reel/watch/share) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="www.facebook.com" android:pathPrefix="/reel"/>
                <data android:scheme="https" android:host="m.facebook.com" android:pathPrefix="/reel"/>
                <data android:scheme="https" android:host="web.facebook.com" android:pathPrefix="/reel"/>
                <data android:scheme="https" android:host="www.facebook.com" android:pathPrefix="/videos"/>
                <data android:scheme="https" android:host="m.facebook.com" android:pathPrefix="/videos"/>
                <data android:scheme="https" android:host="web.facebook.com" android:pathPrefix="/videos"/>
                <data android:scheme="https" android:host="www.facebook.com" android:pathPrefix="/watch"/>
                <data android:scheme="https" android:host="m.facebook.com" android:pathPrefix="/watch"/>
                <data android:scheme="https" android:host="web.facebook.com" android:pathPrefix="/watch"/>
                <data android:scheme="https" android:host="www.facebook.com" android:pathPrefix="/share/v"/>
                <data android:scheme="https" android:host="www.facebook.com" android:pathPrefix="/share/r"/>
                <data android:scheme="https" android:host="www.facebook.com" android:pathPrefix="/story.php"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="fb.watch"/>
                <data android:scheme="https" android:host="fb.me"/>
            </intent-filter>
        </activity>
        <service android:name=".FbAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            android:label="FBResume Accessibility">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service_config"/>
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
    </application>
</manifest>
